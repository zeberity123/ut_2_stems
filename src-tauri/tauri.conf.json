{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UT Stems",
  "version": "0.6.1",
  "identifier": "dev.zeberity123.ut-stems",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; media-src 'self' http://127.0.0.1:*; object-src 'none'; base-uri 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "zeberity123",
    "shortDescription": "Split a song into MP3 stems",
    "longDescription": "Splits a song (an audio file or a YouTube link) into MP3 stems: vocals, bass, drums, guitars, piano and others. The processing engine is downloaded on first start.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsi",
        "languages": [
          "English",
          "Korean"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU3MzY4RUJGN0VEQzE5RkEKUldUNkdkeCt2NDQyVjErNnZOdVE3R0FXV2kvdVdpdEN0Q21NQkwyYU1MdnFQeEx1ZHA4bVNOZXoK",
      "endpoints": [
        "https://github.com/zeberity123/ut_2_stems/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
