{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UT Stems",
  "version": "0.5.0",
  "identifier": "dev.zeberity123.ut-stems",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "zeberity123",
    "shortDescription": "Split a song into MP3 stems",
    "longDescription": "Splits a song (an audio file or a YouTube link) into MP3 stems: vocals, bass, drums, guitars, piano and others.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Korean"],
        "displayLanguageSelector": false
      }
    }
  }
}
