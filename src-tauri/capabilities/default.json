{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The interface (served by the engine on this PC) and the shell's own setup page may read and save preferences, open dialogs, receive dropped files and install the engine.",
  "windows": ["main"],
  "remote": { "urls": ["http://127.0.0.1:*"] },
  "permissions": [
    "core:default",
    "allow-get-preferences",
    "allow-set-preferences",
    "allow-choose-files",
    "allow-choose-folder",
    "allow-engine-status",
    "allow-choose-engine-file",
    "allow-cancel-engine-install",
    "allow-install-engine"
  ]
}
